[20:11:08.257]      // skip if-block "protType == 1"
[20:11:08.257]    </control>
[20:11:08.258]    <control if="protType == 2" while="" timeout="0" info="">
[20:11:08.258]      // if-block "protType == 2"
[20:11:08.258]        // =>  TRUE
[20:11:08.258]      <control if="isSWJ" while="" timeout="0" info="">
[20:11:08.258]        // if-block "isSWJ"
[20:11:08.258]          // =>  TRUE
[20:11:08.258]        <control if="hasDormant" while="" timeout="0" info="">
[20:11:08.259]          // if-block "hasDormant"
[20:11:08.259]            // =>  FALSE
[20:11:08.259]          // skip if-block "hasDormant"
[20:11:08.259]        </control>
[20:11:08.259]        <control if="!hasDormant" while="" timeout="0" info="">
[20:11:08.259]          // if-block "!hasDormant"
[20:11:08.259]            // =>  TRUE
[20:11:08.260]          <block atomic="false" info="">
[20:11:08.260]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:11:08.261]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:11:08.261]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:11:08.261]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:11:08.261]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:11:08.261]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:11:08.261]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:11:08.262]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:11:08.262]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:11:08.262]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:11:08.262]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:11:08.262]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:11:08.262]          </block>
[20:11:08.263]          // end if-block "!hasDormant"
[20:11:08.263]        </control>
[20:11:08.263]        // end if-block "isSWJ"
[20:11:08.263]      </control>
[20:11:08.263]      <control if="!isSWJ" while="" timeout="0" info="">
[20:11:08.263]        // if-block "!isSWJ"
[20:11:08.263]          // =>  FALSE
[20:11:08.263]        // skip if-block "!isSWJ"
