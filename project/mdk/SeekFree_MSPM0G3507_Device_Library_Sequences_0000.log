[20:08:08.877]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:08:08.877]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
