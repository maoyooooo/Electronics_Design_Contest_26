[20:11:08.298]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[20:11:08.299]    <block atomic="false" info="">
[20:11:08.299]      __var deviceID = 0;
[20:11:08.299]        // -> [deviceID <= 0x00000000]
[20:11:08.299]      __var version = 0;
[20:11:08.300]        // -> [version <= 0x00000000]
[20:11:08.300]      __var partNum = 0;
[20:11:08.300]        // -> [partNum <= 0x00000000]
[20:11:08.300]      __var manuf = 0;
[20:11:08.300]        // -> [manuf <= 0x00000000]
[20:11:08.300]      __var isMSPM0G1X0X_G3X0X = 0;
[20:11:08.300]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:11:08.300]      __var isProduction = 0;
[20:11:08.300]        // -> [isProduction <= 0x00000000]
[20:11:08.301]      __var continueId = 0;
[20:11:08.301]        // -> [continueId <= 0x00000000]
[20:11:08.301]      deviceID =   Read32(0x41C40004);
[20:11:08.301]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:11:08.302]        // -> [deviceID <= 0x2BB8802F]
[20:11:08.302]      version = deviceID >> 28;
[20:11:08.302]        // -> [version <= 0x00000002]
[20:11:08.302]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:11:08.302]        // -> [partNum <= 0x0000BB88]
[20:11:08.302]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:11:08.302]        // -> [manuf <= 0x00000017]
[20:11:08.302]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:11:08.302]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:11:08.303]      isProduction = (version > 0);
