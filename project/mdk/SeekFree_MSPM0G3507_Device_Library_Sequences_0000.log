[20:11:08.256]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:11:08.256]    <block atomic="false" info="">
[20:11:08.256]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:11:08.256]        // -> [isSWJ <= 0x00000001]
[20:11:08.256]      __var hasDormant = __protocol & 0x00020000;
[20:11:08.257]        // -> [hasDormant <= 0x00000000]
[20:11:08.257]      __var protType   = __protocol & 0x0000FFFF;
[20:11:08.257]        // -> [protType <= 0x00000002]
[20:11:08.257]    </block>
[20:11:08.257]    <control if="protType == 1" while="" timeout="0" info="">
