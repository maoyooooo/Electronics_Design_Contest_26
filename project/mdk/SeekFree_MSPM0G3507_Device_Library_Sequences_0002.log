[20:15:23.747]          <block atomic="false" info="">
[20:15:23.747]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:15:23.747]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
