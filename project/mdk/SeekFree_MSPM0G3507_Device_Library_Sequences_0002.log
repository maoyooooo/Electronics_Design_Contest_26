[19:27:02.555]    __protocol=0x00010002      (Protocol="SWD", SWJ-DP="True")
[19:27:02.555]    __connection=0x00000202    (Connection Type="Flash", Reset Type="System Reset")
[19:27:02.555]    __dp=0x00000000
[19:27:02.555]    __ap=0x00000000
[19:27:02.555]    __traceout=0x00000000      (Trace Disabled)
