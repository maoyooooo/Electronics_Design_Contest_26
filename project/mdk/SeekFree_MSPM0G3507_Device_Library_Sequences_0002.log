[20:29:18.273]            // =>  TRUE
[20:29:18.273]          <block atomic="false" info="">
[20:29:18.273]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:29:18.273]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
