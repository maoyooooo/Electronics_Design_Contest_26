[20:37:05.181]      WriteDP(DP_SELECT, 0x00000000);
[20:37:05.181]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[20:37:05.182]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
