[19:07:16.162]  <sequence name="DebugDeviceUnlock" Pname="" disable="false" info="">
[19:07:16.162]    <block atomic="false" info="">
[19:07:16.162]      __var deviceID = 0;
[19:07:16.162]        // -> [deviceID <= 0x00000000]
[19:07:16.162]      __var version = 0;
[19:07:16.162]        // -> [version <= 0x00000000]
[19:07:16.162]      __var partNum = 0;
[19:07:16.163]        // -> [partNum <= 0x00000000]
[19:07:16.163]      __var manuf = 0;
[19:07:16.163]        // -> [manuf <= 0x00000000]
[19:07:16.163]      __var isMSPM0G1X0X_G3X0X = 0;
[19:07:16.163]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[19:07:16.163]      __var isProduction = 0;
[19:07:16.163]        // -> [isProduction <= 0x00000000]
[19:07:16.163]      __var continueId = 0;
[19:07:16.163]        // -> [continueId <= 0x00000000]
[19:07:16.164]      deviceID =   Read32(0x41C40004);
[19:07:16.164]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[19:07:16.164]        // -> [deviceID <= 0x2BB8802F]
[19:07:16.164]      version = deviceID >> 28;
[19:07:16.165]        // -> [version <= 0x00000002]
[19:07:16.165]      partNum = (deviceID & 0x0FFFF000) >> 12;
[19:07:16.165]        // -> [partNum <= 0x0000BB88]
[19:07:16.165]      manuf = (deviceID & 0x00000FFE) >> 1;
[19:07:16.165]        // -> [manuf <= 0x00000017]
[19:07:16.165]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[19:07:16.165]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[19:07:16.165]      isProduction = (version > 0);
[19:07:16.165]        // -> [isProduction <= 0x00000001]
[19:07:16.166]    </block>
[19:07:16.166]    <control if="!isMSPM0G1X0X_G3X0X" while="" timeout="0" info="">
[19:07:16.166]      // if-block "!isMSPM0G1X0X_G3X0X"
[19:07:16.166]        // =>  FALSE
[19:07:16.166]      // skip if-block "!isMSPM0G1X0X_G3X0X"
[19:07:16.166]    </control>
[19:07:16.166]    <control if="continueId == 4" while="" timeout="0" info="">
[19:07:16.166]      // if-block "continueId == 4"
[19:07:16.166]        // =>  FALSE
[19:07:16.166]      // skip if-block "continueId == 4"
[19:07:16.167]    </control>
[19:07:16.167]    <control if="!isProduction" while="" timeout="0" info="">
[19:07:16.167]      // if-block "!isProduction"
[19:07:16.167]        // =>  FALSE
[19:07:16.167]      // skip if-block "!isProduction"
[19:07:16.167]    </control>
[19:07:16.167]  </sequence>
