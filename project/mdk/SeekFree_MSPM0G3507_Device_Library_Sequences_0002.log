[19:27:02.556]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[19:27:02.557]    <block atomic="false" info="">
[19:27:02.557]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[19:27:02.557]        // -> [isSWJ <= 0x00000001]
[19:27:02.557]      __var hasDormant = __protocol & 0x00020000;
[19:27:02.557]        // -> [hasDormant <= 0x00000000]
[19:27:02.557]      __var protType   = __protocol & 0x0000FFFF;
[19:27:02.557]        // -> [protType <= 0x00000002]
[19:27:02.557]    </block>
[19:27:02.558]    <control if="protType == 1" while="" timeout="0" info="">
[19:27:02.558]      // if-block "protType == 1"
[19:27:02.558]        // =>  FALSE
[19:27:02.558]      // skip if-block "protType == 1"
[19:27:02.558]    </control>
[19:27:02.559]    <control if="protType == 2" while="" timeout="0" info="">
[19:27:02.559]      // if-block "protType == 2"
[19:27:02.559]        // =>  TRUE
[19:27:02.559]      <control if="isSWJ" while="" timeout="0" info="">
[19:27:02.559]        // if-block "isSWJ"
[19:27:02.559]          // =>  TRUE
[19:27:02.559]        <control if="hasDormant" while="" timeout="0" info="">
[19:27:02.559]          // if-block "hasDormant"
[19:27:02.559]            // =>  FALSE
[19:27:02.559]          // skip if-block "hasDormant"
[19:27:02.560]        </control>
[19:27:02.560]        <control if="!hasDormant" while="" timeout="0" info="">
[19:27:02.560]          // if-block "!hasDormant"
[19:27:02.560]            // =>  TRUE
[19:27:02.560]          <block atomic="false" info="">
[19:27:02.560]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:27:02.560]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:27:02.560]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[19:27:02.561]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[19:27:02.561]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[19:27:02.561]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:27:02.561]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[19:27:02.562]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[19:27:02.562]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[19:27:02.562]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:27:02.562]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[19:27:02.562]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[19:27:02.562]          </block>
[19:27:02.563]          // end if-block "!hasDormant"
[19:27:02.563]        </control>
[19:27:02.563]        // end if-block "isSWJ"
[19:27:02.563]      </control>
[19:27:02.563]      <control if="!isSWJ" while="" timeout="0" info="">
[19:27:02.563]        // if-block "!isSWJ"
[19:27:02.563]          // =>  FALSE
[19:27:02.563]        // skip if-block "!isSWJ"
[19:27:02.563]      </control>
[19:27:02.564]      <block atomic="false" info="">
[19:27:02.564]        ReadDP(0x0);
[19:27:02.564]          // -> [ReadDP(0x00000000) => 0x6BA02477]   (__dp=0x00000000)
[19:27:02.564]      </block>
[19:27:02.564]      // end if-block "protType == 2"
[19:27:02.564]    </control>
