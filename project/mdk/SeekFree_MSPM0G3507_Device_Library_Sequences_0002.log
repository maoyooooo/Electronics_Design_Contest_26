[19:27:02.569]      <block atomic="false" info="">
[19:27:02.570]        Message(0, "Debug/System power-up request sent");
[19:27:02.572]        WriteDP(DP_CTRL_STAT, 0x50000000);
[19:27:02.572]          // -> [WriteDP(0x00000004, 0x50000000)]   (__dp=0x00000000)
[19:27:02.573]      </block>
[19:27:02.573]      <control if="" while="(ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000" timeout="1000000" info="">
