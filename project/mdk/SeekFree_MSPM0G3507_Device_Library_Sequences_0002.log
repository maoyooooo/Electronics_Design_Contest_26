[19:27:02.567]        // -> [SW_DP_ABORT <= 0x00000000]
[19:27:02.567]      __var DP_CTRL_STAT      = 0x4;
[19:27:02.567]        // -> [DP_CTRL_STAT <= 0x00000004]
[19:27:02.567]      __var DP_SELECT         = 0x8;
[19:27:02.567]        // -> [DP_SELECT <= 0x00000008]
[19:27:02.567]      __var powered_down      = 0;
[19:27:02.567]        // -> [powered_down <= 0x00000000]
[19:27:02.567]      WriteDP(DP_SELECT, 0x00000000);
[19:27:02.568]        // -> [WriteDP(0x00000008, 0x00000000)]   (__dp=0x00000000)
[19:27:02.568]      powered_down = ((ReadDP(DP_CTRL_STAT) & 0xA0000000) != 0xA0000000);
[19:27:02.569]        // -> [ReadDP(0x00000004) => 0x00000040]   (__dp=0x00000000)
[19:27:02.569]        // -> [powered_down <= 0x00000001]
[19:27:02.569]    </block>
[19:27:02.569]    <control if="powered_down" while="" timeout="0" info="">
