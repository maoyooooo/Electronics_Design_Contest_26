[20:15:23.788]      __var isProduction = 0;
[20:15:23.788]        // -> [isProduction <= 0x00000000]
[20:15:23.789]      __var continueId = 0;
[20:15:23.789]        // -> [continueId <= 0x00000000]
[20:15:23.789]      deviceID =   Read32(0x41C40004);
[20:15:23.789]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:15:23.789]        // -> [deviceID <= 0x2BB8802F]
[20:15:23.789]      version = deviceID >> 28;
[20:15:23.790]        // -> [version <= 0x00000002]
[20:15:23.790]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:15:23.790]        // -> [partNum <= 0x0000BB88]
[20:15:23.790]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:15:23.790]        // -> [manuf <= 0x00000017]
[20:15:23.790]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:15:23.790]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:15:23.790]      isProduction = (version > 0);
