[18:28:01.816]        </control>
[18:28:01.816]        <control if="!hasDormant" while="" timeout="0" info="">
[18:28:01.816]          // if-block "!hasDormant"
[18:28:01.816]            // =>  TRUE
[18:28:01.816]          <block atomic="false" info="">
[18:28:01.816]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:28:01.817]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:28:01.817]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:28:01.817]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:28:01.817]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[18:28:01.817]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:28:01.818]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[18:28:01.818]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[18:28:01.818]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[18:28:01.818]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:28:01.818]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:28:01.818]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:28:01.819]          </block>
[18:28:01.819]          // end if-block "!hasDormant"
[18:28:01.819]        </control>
[18:28:01.819]        // end if-block "isSWJ"
[18:28:01.819]      </control>
