[19:39:23.289]            // =>  TRUE
[19:39:23.289]          <block atomic="false" info="">
[19:39:23.289]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:39:23.289]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
