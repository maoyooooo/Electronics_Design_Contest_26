[20:54:16.260]        // =>  TRUE
[20:54:16.260]      <control if="isSWJ" while="" timeout="0" info="">
[20:54:16.260]        // if-block "isSWJ"
[20:54:16.260]          // =>  TRUE
[20:54:16.260]        <control if="hasDormant" while="" timeout="0" info="">
[20:54:16.260]          // if-block "hasDormant"
[20:54:16.260]            // =>  FALSE
[20:54:16.261]          // skip if-block "hasDormant"
[20:54:16.261]        </control>
[20:54:16.261]        <control if="!hasDormant" while="" timeout="0" info="">
[20:54:16.261]          // if-block "!hasDormant"
[20:54:16.261]            // =>  TRUE
[20:54:16.261]          <block atomic="false" info="">
[20:54:16.261]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:54:16.261]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:54:16.262]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:54:16.262]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:54:16.262]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:54:16.262]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:54:16.262]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
[20:54:16.262]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E79E)]
[20:54:16.263]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF);  //Ensure the switch is successful 
[20:54:16.263]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:54:16.263]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[20:54:16.263]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[20:54:16.263]          </block>
