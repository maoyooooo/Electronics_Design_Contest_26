[19:07:16.132]          // if-block "hasDormant"
[19:07:16.132]            // =>  FALSE
[19:07:16.132]          // skip if-block "hasDormant"
[19:07:16.132]        </control>
[19:07:16.132]        <control if="!hasDormant" while="" timeout="0" info="">
[19:07:16.132]          // if-block "!hasDormant"
[19:07:16.132]            // =>  TRUE
[19:07:16.132]          <block atomic="false" info="">
[19:07:16.132]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[19:07:16.133]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[19:07:16.133]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
