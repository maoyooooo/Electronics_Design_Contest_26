[20:27:36.708]        </control>
[20:27:36.708]        <control if="!hasDormant" while="" timeout="0" info="">
[20:27:36.708]          // if-block "!hasDormant"
[20:27:36.708]            // =>  TRUE
[20:27:36.708]          <block atomic="false" info="">
[20:27:36.708]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[20:27:36.709]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:27:36.709]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[20:27:36.709]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[20:27:36.709]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
[20:27:36.709]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[20:27:36.709]            DAP_SWJ_Sequence(16, 0xE79E); //JTAG to SWD switch
