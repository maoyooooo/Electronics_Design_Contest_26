[19:27:02.574]        <block atomic="false" info="">
[19:27:02.574]          Message(0, "executing SWD power up");
[19:27:02.575]          WriteDP(DP_CTRL_STAT, 0x50000F00);
[19:27:02.575]            // -> [WriteDP(0x00000004, 0x50000F00)]   (__dp=0x00000000)
