[18:41:07.736]            // =>  TRUE
[18:41:07.736]          <block atomic="false" info="">
[18:41:07.736]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //lets put the JTAG line in a reset state
[18:41:07.736]              // -> [DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF)]
[18:41:07.736]            DAP_SWJ_Sequence(16,0xE73C); //SWD to JTAG, this is to ensure the state machine is initialized
[18:41:07.737]              // -> [DAP_SWJ_Sequence(16, 0x000000000000E73C)]
[18:41:07.737]            DAP_SWJ_Sequence(51, 0x0007FFFFFFFFFFFF); //Put it back in reset
