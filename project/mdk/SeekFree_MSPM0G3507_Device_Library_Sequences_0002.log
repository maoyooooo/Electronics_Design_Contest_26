[20:47:20.930]      __var isMSPM0G1X0X_G3X0X = 0;
[20:47:20.930]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000000]
[20:47:20.930]      __var isProduction = 0;
[20:47:20.930]        // -> [isProduction <= 0x00000000]
[20:47:20.930]      __var continueId = 0;
[20:47:20.930]        // -> [continueId <= 0x00000000]
[20:47:20.930]      deviceID =   Read32(0x41C40004);
[20:47:20.931]        // -> [Read32(0x41C40004) => 0x2BB8802F]   (__dp=0x00000000, __ap=0x00000000)
[20:47:20.931]        // -> [deviceID <= 0x2BB8802F]
[20:47:20.931]      version = deviceID >> 28;
[20:47:20.931]        // -> [version <= 0x00000002]
[20:47:20.931]      partNum = (deviceID & 0x0FFFF000) >> 12;
[20:47:20.931]        // -> [partNum <= 0x0000BB88]
[20:47:20.931]      manuf = (deviceID & 0x00000FFE) >> 1;
[20:47:20.931]        // -> [manuf <= 0x00000017]
[20:47:20.932]      isMSPM0G1X0X_G3X0X = (partNum == 0xBB88) && (manuf == 0x17);
[20:47:20.932]        // -> [isMSPM0G1X0X_G3X0X <= 0x00000001]
[20:47:20.932]      isProduction = (version > 0);
[20:47:20.932]        // -> [isProduction <= 0x00000001]
