[18:41:07.738]            DAP_SWJ_Sequence(7,  0x00); //Give the line some time to initialize
[18:41:07.738]              // -> [DAP_SWJ_Sequence(7, 0x0000000000000000)]
[18:41:07.738]          </block>
[18:41:07.738]          // end if-block "!hasDormant"
[18:41:07.738]        </control>
[18:41:07.738]        // end if-block "isSWJ"
