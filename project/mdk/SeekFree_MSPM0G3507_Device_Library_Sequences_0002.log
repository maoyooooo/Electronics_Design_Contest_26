[20:54:16.258]  <sequence name="DebugPortSetup" Pname="" disable="false" info="">
[20:54:16.258]    <block atomic="false" info="">
[20:54:16.258]      __var isSWJ      = ((__protocol & 0x00010000) != 0);
[20:54:16.259]        // -> [isSWJ <= 0x00000001]
[20:54:16.259]      __var hasDormant = __protocol & 0x00020000;
[20:54:16.259]        // -> [hasDormant <= 0x00000000]
